# The R36S build image for the 32-bit build (the port's target, see
# docs/R36S_PORT.md): Debian 10 (glibc 2.28, PortMaster's usual baseline),
# the armhf cross compiler, the armhf GLES/EGL headers and SDL 2.28 with the
# KMSDRM and ALSA back ends, loaded at run time.
#
#   docker build -t nfshp2-r36s-build-armhf -f r36s/Dockerfile.armhf r36s
FROM --platform=linux/amd64 debian:10-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN sed -i 's|deb.debian.org|archive.debian.org|g; s|security.debian.org|archive.debian.org|g' /etc/apt/sources.list \
    && sed -i '/buster-updates/d' /etc/apt/sources.list \
    && dpkg --add-architecture armhf \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates cmake curl file make ninja-build pkg-config python3 \
        gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf binutils-arm-linux-gnueabihf libc6-dev-armhf-cross \
        libasound2-dev:armhf libdrm-dev:armhf libegl1-mesa-dev:armhf \
        libgbm-dev:armhf libgles2-mesa-dev:armhf libudev-dev:armhf \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --retry 3 \
        https://github.com/libsdl-org/SDL/releases/download/release-2.28.5/SDL2-2.28.5.tar.gz \
        --output /tmp/SDL2.tar.gz \
    && tar -xzf /tmp/SDL2.tar.gz -C /tmp \
    && PKG_CONFIG_LIBDIR=/usr/lib/arm-linux-gnueabihf/pkgconfig:/usr/share/pkgconfig \
       cmake -S /tmp/SDL2-2.28.5 -B /tmp/sdl-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_SYSTEM_NAME=Linux \
        -DCMAKE_SYSTEM_PROCESSOR=armv7l -DCMAKE_C_COMPILER=arm-linux-gnueabihf-gcc -DCMAKE_CXX_COMPILER=arm-linux-gnueabihf-g++ \
        -DCMAKE_C_FLAGS="-march=armv7-a -mfpu=neon-vfpv4 -mfloat-abi=hard" \
        -DCMAKE_INSTALL_PREFIX=/opt/r36s \
        -DSDL_SHARED=ON -DSDL_STATIC=OFF -DSDL_TEST=OFF \
        -DSDL_KMSDRM=ON -DSDL_KMSDRM_SHARED=ON -DSDL_ALSA=ON -DSDL_ALSA_SHARED=ON \
        -DSDL_PULSEAUDIO=OFF -DSDL_X11=OFF -DSDL_WAYLAND=OFF \
        -DSDL_OPENGL=OFF -DSDL_OPENGLES=ON \
    && cmake --build /tmp/sdl-build -- -j4 \
    && cmake --build /tmp/sdl-build --target install \
    && cp /tmp/SDL2-2.28.5/LICENSE.txt /opt/r36s/LICENSE-SDL2.txt \
    && rm -rf /tmp/SDL2.tar.gz /tmp/SDL2-2.28.5 /tmp/sdl-build

WORKDIR /r36s
